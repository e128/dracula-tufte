{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Dracula-Tufte",
  "author": "the maintainer",
  "themes": [
    {
      "name": "Dracula-Tufte (muted)",
      "appearance": "dark",
      "style": {
        "accents": [
          "#{{pink}}ff",
          "#{{purple}}ff",
          "#{{link}}ff",
          "#{{green}}ff",
          "#{{orange}}ff",
          "#{{data-1}}ff",
          "#{{data-2}}ff",
          "#{{data-3}}ff",
          "#{{data-4}}ff"
        ],
        "background.appearance": "opaque",
        "border": "#{{mix:surface:rule-light:30}}ff",
        "border.variant": "#{{mix:surface:rule-light:20}}ff",
        "border.focused": "#{{link}}ff",
        "border.selected": "#{{link}}ff",
        "border.transparent": "#00000000",
        "border.disabled": "#{{mix:surface:rule-light:20}}ff",
        "elevated_surface.background": "#{{code-bg}}ff",
        "surface.background": "#{{surface-alt}}ff",
        "background": "#{{surface}}ff",
        "element.background": "#{{code-bg}}ff",
        "element.hover": "#{{mix:surface:rule-light:20}}ff",
        "element.active": "#{{code-bg.bright}}ff",
        "element.selected": "#{{code-bg.bright}}ff",
        "element.disabled": "#{{surface-alt}}ff",
        "drop_target.background": "#{{mix:surface:link:22}}ff",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#{{mix:surface:rule-light:20}}ff",
        "ghost_element.active": "#{{mix:surface:rule-light:30}}ff",
        "ghost_element.selected": "#{{code-bg.bright}}ff",
        "ghost_element.disabled": "#00000000",
        "text": "#{{on-surface}}ff",
        "text.muted": "#{{muted}}ff",
        "text.placeholder": "#{{rule-light}}ff",
        "text.disabled": "#{{rule-light}}ff",
        "text.accent": "#{{link}}ff",
        "icon": "#{{label}}ff",
        "icon.muted": "#{{muted}}ff",
        "icon.disabled": "#{{rule-light}}ff",
        "icon.placeholder": "#{{rule-light}}ff",
        "icon.accent": "#{{link}}ff",
        "status_bar.background": "#{{surface-alt}}ff",
        "title_bar.background": "#{{surface-alt}}ff",
        "title_bar.inactive_background": "#{{surface-alt}}ff",
        "toolbar.background": "#{{surface}}ff",
        "tab_bar.background": "#{{surface-alt}}ff",
        "tab.inactive_background": "#{{surface-alt}}ff",
        "tab.active_background": "#{{surface}}ff",
        "search.match_background": "#{{mix:surface:orange:35}}ff",
        "panel.background": "#{{surface-alt}}ff",
        "panel.focused_border": "#{{link}}ff",
        "panel.indent_guide": "#{{mix:surface:rule-light:30}}ff",
        "panel.indent_guide_active": "#{{rule-light}}ff",
        "panel.indent_guide_hover": "#{{rule-light}}ff",
        "pane.focused_border": "#{{link}}ff",
        "pane_group.border": "#{{mix:surface:rule-light:30}}ff",
        "scrollbar.thumb.background": "#{{mix:surface:rule-light:40}}ff",
        "scrollbar.thumb.hover_background": "#{{rule-light}}ff",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#{{mix:surface:rule-light:20}}ff",
        "editor.foreground": "#{{on-surface}}ff",
        "editor.background": "#{{surface}}ff",
        "editor.gutter.background": "#{{surface}}ff",
        "editor.subheader.background": "#{{surface-alt}}ff",
        "editor.active_line.background": "#{{mix:surface:rule-light:12}}ff",
        "editor.highlighted_line.background": "#{{mix:surface:purple:20}}ff",
        "editor.line_number": "#{{rule-light}}ff",
        "editor.active_line_number": "#{{label}}ff",
        "editor.invisible": "#{{mix:surface:rule-light:60}}ff",
        "editor.wrap_guide": "#{{mix:surface:rule-light:30}}ff",
        "editor.active_wrap_guide": "#{{rule-light}}ff",
        "editor.document_highlight.read_background": "#{{mix:surface:link:22}}ff",
        "editor.document_highlight.write_background": "#{{mix:surface:orange:20}}ff",
        "editor.document_highlight.bracket_background": "#{{mix:surface:purple:20}}ff",
        "editor.indent_guide": "#{{mix:surface:rule-light:30}}ff",
        "editor.indent_guide_active": "#{{rule-light}}ff",
        "link_text.hover": "#{{link}}ff",
        "conflict": "#{{data-2}}ff",
        "conflict.background": "#{{mix:surface:data-2:20}}ff",
        "conflict.border": "#{{data-2}}ff",
        "created": "#{{data-3}}ff",
        "created.background": "#{{mix:surface:data-3:20}}ff",
        "created.border": "#{{data-3}}ff",
        "deleted": "#{{red}}ff",
        "deleted.background": "#{{mix:surface:red:20}}ff",
        "deleted.border": "#{{red}}ff",
        "error": "#{{red}}ff",
        "error.background": "#{{mix:surface:red:20}}ff",
        "error.border": "#{{red}}ff",
        "hidden": "#{{rule-light}}ff",
        "hidden.background": "#{{surface-alt}}ff",
        "hidden.border": "#{{mix:surface:rule-light:30}}ff",
        "hint": "#{{muted}}ff",
        "hint.background": "#{{mix:surface:data-1:10}}ff",
        "hint.border": "#{{mix:surface:rule-light:30}}ff",
        "ignored": "#{{rule-light}}ff",
        "ignored.background": "#{{surface-alt}}ff",
        "ignored.border": "#{{mix:surface:rule-light:30}}ff",
        "info": "#{{data-1}}ff",
        "info.background": "#{{mix:surface:data-1:20}}ff",
        "info.border": "#{{data-1}}ff",
        "modified": "#{{data-1}}ff",
        "modified.background": "#{{mix:surface:data-1:20}}ff",
        "modified.border": "#{{data-1}}ff",
        "predictive": "#{{rule-light}}ff",
        "predictive.background": "#{{mix:surface:data-3:10}}ff",
        "predictive.border": "#{{mix:surface:rule-light:30}}ff",
        "renamed": "#{{data-1}}ff",
        "renamed.background": "#{{mix:surface:data-1:20}}ff",
        "renamed.border": "#{{data-1}}ff",
        "success": "#{{data-3}}ff",
        "success.background": "#{{mix:surface:data-3:20}}ff",
        "success.border": "#{{data-3}}ff",
        "unreachable": "#{{rule-light}}ff",
        "unreachable.border": "#{{mix:surface:rule-light:30}}ff",
        "warning": "#{{orange}}ff",
        "warning.background": "#{{mix:surface:orange:20}}ff",
        "warning.border": "#{{orange}}ff",
        "terminal.background": "#{{surface-alt}}ff",
        "terminal.foreground": "#{{on-surface}}ff",
        "terminal.bright_foreground": "#{{on-surface.bright}}ff",
        "terminal.dim_foreground": "#{{muted}}ff",
        "terminal.ansi.background": "#{{surface-alt}}ff",
        "terminal.ansi.black": "#{{surface-alt}}ff",
        "terminal.ansi.bright_black": "#{{rule-light}}ff",
        "terminal.ansi.dim_black": "#{{mix:surface-alt:rule-light:35}}ff",
        "terminal.ansi.red": "#{{red}}ff",
        "terminal.ansi.bright_red": "#{{red.bright}}ff",
        "terminal.ansi.dim_red": "#{{mix:surface:red:65}}ff",
        "terminal.ansi.green": "#{{green}}ff",
        "terminal.ansi.bright_green": "#{{green.bright}}ff",
        "terminal.ansi.dim_green": "#{{mix:surface:green:65}}ff",
        "terminal.ansi.yellow": "#{{data-4}}ff",
        "terminal.ansi.bright_yellow": "#{{orange}}ff",
        "terminal.ansi.dim_yellow": "#{{mix:surface:data-4:65}}ff",
        "terminal.ansi.blue": "#{{data-1}}ff",
        "terminal.ansi.bright_blue": "#{{data-1.bright}}ff",
        "terminal.ansi.dim_blue": "#{{mix:surface:data-1:65}}ff",
        "terminal.ansi.magenta": "#{{purple}}ff",
        "terminal.ansi.bright_magenta": "#{{pink}}ff",
        "terminal.ansi.dim_magenta": "#{{mix:surface:purple:65}}ff",
        "terminal.ansi.cyan": "#{{link}}ff",
        "terminal.ansi.bright_cyan": "#{{link.bright}}ff",
        "terminal.ansi.dim_cyan": "#{{mix:surface:link:65}}ff",
        "terminal.ansi.white": "#{{label}}ff",
        "terminal.ansi.bright_white": "#{{on-surface.bright}}ff",
        "terminal.ansi.dim_white": "#{{muted}}ff",
        "vim.normal.background": "#{{mix:surface:link:22}}ff",
        "vim.insert.background": "#{{mix:surface:data-3:20}}ff",
        "vim.replace.background": "#{{mix:surface:red:20}}ff",
        "vim.visual.background": "#{{mix:surface:purple:20}}ff",
        "vim.visual_line.background": "#{{mix:surface:purple:20}}ff",
        "vim.visual_block.background": "#{{mix:surface:purple:20}}ff",
        "vim.helix_normal.background": "#{{mix:surface:link:22}}ff",
        "vim.helix_select.background": "#{{mix:surface:data-2:20}}ff",
        "vim.mode.text": "#{{on-surface}}ff",
        "players": [
          { "cursor": "#{{pink}}ff", "background": "#{{pink}}ff", "selection": "#{{pink}}33" },
          { "cursor": "#{{link}}ff", "background": "#{{link}}ff", "selection": "#{{link}}33" },
          { "cursor": "#{{data-1}}ff", "background": "#{{data-1}}ff", "selection": "#{{data-1}}33" },
          { "cursor": "#{{data-2}}ff", "background": "#{{data-2}}ff", "selection": "#{{data-2}}33" },
          { "cursor": "#{{data-3}}ff", "background": "#{{data-3}}ff", "selection": "#{{data-3}}33" },
          { "cursor": "#{{data-4}}ff", "background": "#{{data-4}}ff", "selection": "#{{data-4}}33" },
          { "cursor": "#{{purple}}ff", "background": "#{{purple}}ff", "selection": "#{{purple}}33" }
        ],
        "syntax": {
          "attribute": { "color": "#{{green}}ff", "font_style": null, "font_weight": null },
          "boolean": { "color": "#{{orange}}ff", "font_style": null, "font_weight": null },
          "comment": { "color": "#{{muted}}ff", "font_style": "italic", "font_weight": null },
          "comment.doc": { "color": "#{{muted}}ff", "font_style": "italic", "font_weight": null },
          "constant": { "color": "#{{orange}}ff", "font_style": null, "font_weight": null },
          "constructor": { "color": "#{{purple}}ff", "font_style": null, "font_weight": null },
          "embedded": { "color": "#{{on-surface}}ff", "font_style": null, "font_weight": null },
          "emphasis": { "color": "#{{purple}}ff", "font_style": "italic", "font_weight": null },
          "emphasis.strong": { "color": "#{{orange}}ff", "font_style": null, "font_weight": 600 },
          "enum": { "color": "#{{purple}}ff", "font_style": null, "font_weight": null },
          "function": { "color": "#{{link}}ff", "font_style": null, "font_weight": null },
          "hint": { "color": "#{{muted}}ff", "font_style": "italic", "font_weight": null },
          "keyword": { "color": "#{{pink}}ff", "font_style": null, "font_weight": null },
          "label": { "color": "#{{data-4}}ff", "font_style": null, "font_weight": null },
          "link_text": { "color": "#{{link}}ff", "font_style": "italic", "font_weight": null },
          "link_uri": { "color": "#{{link}}ff", "font_style": null, "font_weight": null },
          "number": { "color": "#{{orange}}ff", "font_style": null, "font_weight": null },
          "operator": { "color": "#{{pink}}ff", "font_style": null, "font_weight": null },
          "predictive": { "color": "#{{rule-light}}ff", "font_style": "italic", "font_weight": null },
          "preproc": { "color": "#{{data-2}}ff", "font_style": null, "font_weight": null },
          "primary": { "color": "#{{on-surface}}ff", "font_style": null, "font_weight": null },
          "property": { "color": "#{{label}}ff", "font_style": null, "font_weight": null },
          "punctuation": { "color": "#{{label}}ff", "font_style": null, "font_weight": null },
          "punctuation.bracket": { "color": "#{{label}}ff", "font_style": null, "font_weight": null },
          "punctuation.delimiter": { "color": "#{{label}}ff", "font_style": null, "font_weight": null },
          "punctuation.list_marker": { "color": "#{{muted}}ff", "font_style": null, "font_weight": null },
          "punctuation.special": { "color": "#{{pink}}ff", "font_style": null, "font_weight": null },
          "string": { "color": "#{{green}}ff", "font_style": null, "font_weight": null },
          "string.escape": { "color": "#{{orange}}ff", "font_style": null, "font_weight": null },
          "string.regex": { "color": "#{{green}}ff", "font_style": null, "font_weight": null },
          "string.special": { "color": "#{{green}}ff", "font_style": null, "font_weight": null },
          "string.special.symbol": { "color": "#{{green}}ff", "font_style": null, "font_weight": null },
          "tag": { "color": "#{{label}}ff", "font_style": null, "font_weight": null },
          "text.literal": { "color": "#{{green}}ff", "font_style": null, "font_weight": null },
          "title": { "color": "#{{pink}}ff", "font_style": null, "font_weight": 400 },
          "type": { "color": "#{{purple}}ff", "font_style": null, "font_weight": null },
          "type.interface": { "color": "#{{purple}}ff", "font_style": "italic", "font_weight": null },
          "type.super": { "color": "#{{purple}}ff", "font_style": null, "font_weight": null },
          "variable": { "color": "#{{on-surface}}ff", "font_style": null, "font_weight": null },
          "variable.member": { "color": "#{{label}}ff", "font_style": null, "font_weight": null },
          "variable.parameter": { "color": "#{{label}}ff", "font_style": null, "font_weight": null },
          "variable.special": { "color": "#{{data-2}}ff", "font_style": null, "font_weight": null },
          "variant": { "color": "#{{data-1}}ff", "font_style": null, "font_weight": null }
        }
      }
    },
