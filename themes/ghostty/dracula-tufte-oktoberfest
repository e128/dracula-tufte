# Dracula-Tufte (muted) Oktoberfest: Ghostty theme
#
# Every value is the sRGB rendering of a tufte-dracula.css :root oklch() token,
# computed with .github/palette-check.py's oklch_to_hex. Values come from the
# seasonal block behind data-season="oktoberfest". Bright ANSI slots that have no
# token of their own are the same hue and chroma at L + 0.07.
#
# This is a seasonal theme selected by hand, not a calendar switch.
#
# Install: copy this file to ~/.config/ghostty/themes/, then set
#          `theme = dracula-tufte-oktoberfest` in ~/.config/ghostty/config.

background = #402712
foreground = #faf5ea

cursor-color = #e38ab5
cursor-text = #402712

selection-background = #63462d
selection-foreground = #faf5ea

palette = 0=#311c09
palette = 1=#ff7a7b
palette = 2=#96cd76
palette = 3=#eea888
palette = 4=#70c7ef
palette = 5=#65bae1
palette = 6=#8fc7e2
palette = 7=#d8c8ae
palette = 8=#9b806b
palette = 9=#ffa2a0
palette = 10=#ace48c
palette = 11=#f2af48
palette = 12=#94dcff
palette = 13=#e38ab5
palette = 14=#a5defa
palette = 15=#fffbf4
