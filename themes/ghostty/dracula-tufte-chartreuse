# Dracula-Tufte (muted) Chartreuse: Ghostty theme
#
# Every value is the sRGB rendering of a tufte-dracula.css :root oklch() token,
# computed with .github/palette-check.py's oklch_to_hex. Values come from the
# seasonal block behind data-season="chartreuse". Bright ANSI slots that have no
# token of their own are the same hue and chroma at L + 0.07.
#
# This is a seasonal theme selected by hand, not a calendar switch.
#
# Install: copy this file to ~/.config/ghostty/themes/, then set
#          `theme = dracula-tufte-chartreuse` in ~/.config/ghostty/config.

background = #4d5208
foreground = #f7f8ed

cursor-color = #ffaed4
cursor-text = #4d5208

selection-background = #585d1e
selection-foreground = #f7f8ed

palette = 0=#3f4405
palette = 1=#ffafae
palette = 2=#c9d374
palette = 3=#d7b767
palette = 4=#97bef0
palette = 5=#b5df76
palette = 6=#9dd7d7
palette = 7=#dee3b5
palette = 8=#b0b591
palette = 9=#ffd1d0
palette = 10=#e0eb8b
palette = 11=#e7be67
palette = 12=#b3d4ff
palette = 13=#ffaed4
palette = 14=#b3eeee
palette = 15=#fcfdf2
