# Dracula-Tufte (muted) Aurora: Ghostty theme
#
# Every value is the sRGB rendering of a tufte-dracula.css :root oklch() token,
# computed with .github/palette-check.py's oklch_to_hex. Values come from the
# seasonal block behind data-season="aurora". Bright ANSI slots that have no
# token of their own are the same hue and chroma at L + 0.07.
#
# This is a seasonal theme selected by hand, not a calendar switch.
#
# Install: copy this file to ~/.config/ghostty/themes/, then set
#          `theme = dracula-tufte-aurora` in ~/.config/ghostty/config.

background = #0f0528
foreground = #eff6fb

cursor-color = #e095c7
cursor-text = #0f0528

selection-background = #29214b
selection-foreground = #eff6fb

palette = 0=#06001b
palette = 1=#ff7a7b
palette = 2=#75d78d
palette = 3=#dab567
palette = 4=#4eccf0
palette = 5=#b699ea
palette = 6=#82cbd8
palette = 7=#adc5d6
palette = 8=#6b748d
palette = 9=#ffa2a0
palette = 10=#8ceea3
palette = 11=#e6b14e
palette = 12=#7fe1ff
palette = 13=#e095c7
palette = 14=#99e2f0
palette = 15=#f9fcff
