# Dracula-Tufte (muted) Birthday: Ghostty theme
#
# Every value is the sRGB rendering of a tufte-dracula.css :root oklch() token,
# computed with .github/palette-check.py's oklch_to_hex. Values come from the
# seasonal block behind data-season="birthday". Bright ANSI slots that have no
# token of their own are the same hue and chroma at L + 0.07.
#
# This is a seasonal theme selected by hand, not a calendar switch.
#
# Install: copy this file to ~/.config/ghostty/themes/, then set
#          `theme = dracula-tufte-birthday` in ~/.config/ghostty/config.

background = #29050e
foreground = #f9f5ec

cursor-color = #fd8994
cursor-text = #29050e

selection-background = #4e232b
selection-foreground = #f9f5ec

palette = 0=#1d0106
palette = 1=#ff7a7b
palette = 2=#5ad5a6
palette = 3=#dab567
palette = 4=#62c9f0
palette = 5=#e484b3
palette = 6=#8cc8e0
palette = 7=#d5c5ab
palette = 8=#856f83
palette = 9=#ffa2a0
palette = 10=#73ecbc
palette = 11=#e5b64a
palette = 12=#8bdeff
