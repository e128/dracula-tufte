# Dracula-Tufte (muted) Bois Jacques: Ghostty theme
#
# Every value is the sRGB rendering of a tufte-dracula.css :root oklch() token,
# computed with .github/palette-check.py's oklch_to_hex. Values come from the
# seasonal block behind data-season="bois-jacques". Bright ANSI slots that have no
# token of their own are the same hue and chroma at L + 0.07.
#
# This is a seasonal theme selected by hand, not a calendar switch.
#
# Install: copy this file to ~/.config/ghostty/themes/, then set
#          `theme = dracula-tufte-bois-jacques` in ~/.config/ghostty/config.

background = #11161d
foreground = #eff4f8

cursor-color = #dd9ab9
cursor-text = #11161d

selection-background = #2e363f
selection-foreground = #eff4f8

palette = 0=#070b11
palette = 1=#ff716b
palette = 2=#91cb9c
palette = 3=#d5b867
palette = 4=#97bef0
palette = 5=#9f9dd8
palette = 6=#8bc3e4
palette = 7=#b1c0cd
palette = 8=#687686
palette = 9=#ff9b93
palette = 10=#a7e2b2
palette = 11=#f3ae51
palette = 12=#b3d4ff
palette = 13=#dd9ab9
palette = 14=#a1dafc
palette = 15=#f9fcff
