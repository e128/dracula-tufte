# Dracula-Tufte (muted) Thanksgiving: Ghostty theme
#
# Every value is the sRGB rendering of a tufte-dracula.css :root oklch() token,
# computed with .github/palette-check.py's oklch_to_hex. Values come from the
# seasonal block behind data-season="thanksgiving". Bright ANSI slots that have no
# token of their own are the same hue and chroma at L + 0.07.
#
# This is a third theme selected by hand, not a calendar switch.
#
# Install: copy this file to ~/.config/ghostty/themes/, then set
#          `theme = dracula-tufte-thanksgiving` in ~/.config/ghostty/config.

background = #291b0f
foreground = #f9f6eb

cursor-color = #df879b
cursor-text = #291b0f

selection-background = #4d3b30
selection-foreground = #f9f6eb

palette = 0=#1b1008
palette = 1=#ff7a7a
palette = 2=#a0c679
palette = 3=#dab567
palette = 4=#97bef0
palette = 5=#c287bc
palette = 6=#84c7d3
palette = 7=#d9c4a8
palette = 8=#867162
palette = 9=#ffa29f
palette = 10=#b6dd8f
palette = 11=#f7aa45
palette = 12=#b3d4ff
