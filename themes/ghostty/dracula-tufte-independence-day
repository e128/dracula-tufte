# Dracula-Tufte (muted) Independence Day: Ghostty theme
#
# Every value is the sRGB rendering of a tufte-dracula.css :root oklch() token,
# computed with .github/palette-check.py's oklch_to_hex. Values come from the
# seasonal block behind data-season="independence-day". Bright ANSI slots that have no
# token of their own are the same hue and chroma at L + 0.07.
#
# This is a seasonal theme selected by hand, not a calendar switch.
#
# Install: copy this file to ~/.config/ghostty/themes/, then set
#          `theme = dracula-tufte-independence-day` in ~/.config/ghostty/config.

background = #101d38
foreground = #f2f7fd

cursor-color = #f18093
cursor-text = #101d38

selection-background = #2c3b5b
selection-foreground = #f2f7fd

palette = 0=#071129
palette = 1=#ff7a7e
palette = 2=#66d5ba
palette = 3=#d7b767
palette = 4=#97bef0
palette = 5=#82a3ec
palette = 6=#96c6dd
palette = 7=#b8cde4
palette = 8=#6e829b
palette = 9=#ffa2a2
palette = 10=#7eecd0
palette = 11=#e7af5c
palette = 12=#b3d4ff
palette = 13=#f18093
palette = 14=#acdcf5
palette = 15=#f9fcff
