# Dracula-Tufte (muted) Christmas: Ghostty theme
#
# Every value is the sRGB rendering of a tufte-dracula.css :root oklch() token,
# computed with .github/palette-check.py's oklch_to_hex. Values come from the
# seasonal block behind data-season="christmas". Bright ANSI slots that have no
# token of their own are the same hue and chroma at L + 0.07.
#
# This is a third theme selected by hand, not a calendar switch.
#
# Install: copy this file to ~/.config/ghostty/themes/, then set
#          `theme = dracula-tufte-xmas` in ~/.config/ghostty/config.

background = #182c1f
foreground = #faf8ef

cursor-color = #ec7584
cursor-text = #182c1f

selection-background = #364d3d
selection-foreground = #faf8ef

palette = 0=#0d1e13
palette = 1=#ff7a7e
palette = 2=#84cb74
palette = 3=#d7b767
palette = 4=#97bef0
palette = 5=#4ab769
palette = 6=#9fc5d9
palette = 7=#b3d0b8
palette = 8=#5d7e68
palette = 9=#ffa2a2
palette = 10=#9ae28a
palette = 11=#d3b064
palette = 12=#b3d4ff
palette = 13=#ec7584
palette = 14=#b5dbf1
palette = 15=#fefcf3
