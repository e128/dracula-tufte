# Dracula-Tufte (muted) Poland: Ghostty theme
#
# Every value is the sRGB rendering of a tufte-dracula.css :root oklch() token,
# computed with .github/palette-check.py's oklch_to_hex. Values come from the
# seasonal block behind data-season="poland". Bright ANSI slots that have no
# token of their own are the same hue and chroma at L + 0.07.
#
# This is a seasonal theme selected by hand, not a calendar switch.
#
# Install: copy this file to ~/.config/ghostty/themes/, then set
#          `theme = dracula-tufte-poland` in ~/.config/ghostty/config.

background = #371111
foreground = #f8f7f2

cursor-color = #fa96a3
cursor-text = #371111

selection-background = #5d2f2e
selection-foreground = #f8f7f2

palette = 0=#27080a
palette = 1=#ff716b
palette = 2=#cdc072
palette = 3=#e4b067
palette = 4=#e2b349
palette = 5=#d87ca9
palette = 6=#debe82
palette = 7=#daccb5
palette = 8=#9c7571
palette = 9=#ff9b93
palette = 10=#e3d688
palette = 11=#e7b551
palette = 12=#f9ca61
palette = 13=#fa96a3
