# Dracula-Tufte (muted): Ghostty theme
#
# Every value is the sRGB rendering of a tufte-dracula.css :root oklch() token,
# computed with .github/palette-check.py's oklch_to_hex. Bright ANSI slots that
# have no token of their own are the same hue and chroma at L + 0.07.
#
# Install: copy this file to ~/.config/ghostty/themes/dracula-tufte
#          then add `theme = dracula-tufte` to ~/.config/ghostty/config

background = #282a36
foreground = #f8f8f2

cursor-color = #f081ba
cursor-text = #282a36

selection-background = #464959
selection-foreground = #f8f8f2

palette = 0=#1e1f29
palette = 1=#ff7a7b
palette = 2=#6dcd93
palette = 3=#bcc267
palette = 4=#96bef0
palette = 5=#aa8cdb
palette = 6=#8fc9d9
palette = 7=#b7bfe4
palette = 8=#707388
palette = 9=#ffa2a0
palette = 10=#84e4a9
palette = 11=#eaa465
palette = 12=#b3d4ff
palette = 13=#f081ba
palette = 14=#a5e0f0
palette = 15=#fcfcf6
