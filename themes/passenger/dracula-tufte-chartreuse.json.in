{
  "format": 1,
  "name": "Dracula-Tufte (muted) Chartreuse",
  "description": "The Chartreuse palette as an editor theme, selected by hand and never by the calendar. Dark and light travel in one file.",
  "dark": {
    "Frame": "#{{surface-alt}}",
    "Panel": "#{{surface-alt}}",
    "Field": "#{{code-bg}}",
    "FieldBorder": "#{{rule-light}}",
