    "usesSystemSetting" : false
  },
  "strings" : {
    "color" : "#{{green}}"
  },
  "text" : {
    "color" : "#{{on-surface}}"
  },
  "types" : {
    "color" : "#{{purple.bright}}"
  },
  "values" : {
