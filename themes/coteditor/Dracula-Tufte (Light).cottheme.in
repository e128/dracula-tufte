  },
  "keywords" : {
    "color" : "#{{pink}}"
  },
  "lineHighlight" : {
    "color" : "#{{mix:surface:rule-light:12}}"
  },
  "metadata" : {
    "author" : "the maintainer",
    "description" : "Dracula-Tufte (muted) theme for CotEditor.",
    "distributionURL" : "https:\/\/github.com\/e128\/dracula-tufte",
