{
  "$schema": "https://opencode.ai/theme.json",
  "theme": {
    "primary": "#{{purple}}",
    "secondary": "#{{link}}",
    "accent": "#{{pink}}",
    "error": "#{{red}}",
    "warning": "#{{orange}}",
    "success": "#{{green}}",
    "info": "#{{link}}",
    "text": "#{{on-surface}}",
    "textMuted": "#{{muted}}",
    "background": "#{{surface}}",
    "backgroundPanel": "#{{surface-alt}}",
    "backgroundElement": "#{{code-bg}}",
    "border": "#{{mix:surface:rule-light:30}}",
    "borderActive": "#{{link}}",
    "borderSubtle": "#{{mix:surface:rule-light:20}}",
    "diffAdded": "#{{data-3}}",
    "diffRemoved": "#{{red}}",
    "diffContext": "#{{muted}}",
    "diffHunkHeader": "#{{label}}",
    "diffHighlightAdded": "#{{data-3.bright}}",
    "diffHighlightRemoved": "#{{red.bright}}",
    "diffAddedBg": "#{{mix:surface:data-3:15}}",
    "diffRemovedBg": "#{{mix:surface:red:15}}",
    "diffContextBg": "#{{surface}}",
    "diffLineNumber": "#{{rule-light}}",
    "diffAddedLineNumberBg": "#{{mix:surface:data-3:10}}",
    "diffRemovedLineNumberBg": "#{{mix:surface:red:10}}",
    "syntaxComment": "#{{muted}}",
    "syntaxKeyword": "#{{pink}}",
    "syntaxFunction": "#{{link}}",
    "syntaxVariable": "#{{label}}",
    "syntaxString": "#{{green}}",
    "syntaxNumber": "#{{orange}}",
    "syntaxType": "#{{purple.bright}}",
    "syntaxOperator": "#{{on-surface}}",
    "syntaxPunctuation": "#{{on-surface}}",
    "markdownText": "#{{on-surface}}",
    "markdownHeading": "#{{pink}}",
    "markdownLink": "#{{link}}",
    "markdownLinkText": "#{{link}}",
    "markdownCode": "#{{green}}",
    "markdownBlockQuote": "#{{label}}",
    "markdownEmph": "#{{on-surface}}",
    "markdownStrong": "#{{orange}}",
    "markdownHorizontalRule": "#{{rule-light}}",
    "markdownListItem": "#{{on-surface}}",
    "markdownListEnumeration": "#{{muted}}",
    "markdownImage": "#{{link}}",
    "markdownImageText": "#{{muted}}",
    "markdownCodeBlock": "#{{code-bg}}"
  }
}
