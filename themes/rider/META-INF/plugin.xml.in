<idea-plugin>
  <id>com.e128.dracula-tufte</id>
  <name>Dracula-Tufte (muted)</name>
  <version>{{version}}</version>
  <vendor>e128</vendor>

  <description><![CDATA[
    Dark, light and seasonal UI themes and editor colour schemes derived from the
    Dracula-Tufte (muted) HTML template. Every colour is the sRGB rendering of a
    <code>tufte-dracula.css</code> <code>:root</code> <code>oklch()</code> token, dark
    from the base palette, light from its <code>prefers-color-scheme: light</code>
    override, and each season from the seasonal block behind
    <code>data-season="&lt;season&gt;"</code>.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <idea-version since-build="223" />

  <extensions defaultExtensionNs="com.intellij">
    <themeProvider id="com.e128.dracula-tufte" path="/dracula-tufte.theme.json" />
    <themeProvider id="com.e128.dracula-tufte-light" path="/dracula-tufte-light.theme.json" />
    <themeProvider id="com.e128.dracula-tufte-xmas" path="/dracula-tufte-xmas.theme.json" />
    <themeProvider id="com.e128.dracula-tufte-thanksgiving" path="/dracula-tufte-thanksgiving.theme.json" />
    <themeProvider id="com.e128.dracula-tufte-chartreuse" path="/dracula-tufte-chartreuse.theme.json" />
    <themeProvider id="com.e128.dracula-tufte-st-patrick" path="/dracula-tufte-st-patrick.theme.json" />
    <themeProvider id="com.e128.dracula-tufte-independence-day" path="/dracula-tufte-independence-day.theme.json" />
    <themeProvider id="com.e128.dracula-tufte-poland" path="/dracula-tufte-poland.theme.json" />
    <themeProvider id="com.e128.dracula-tufte-xmas-light" path="/dracula-tufte-xmas-light.theme.json" />
    <themeProvider id="com.e128.dracula-tufte-thanksgiving-light" path="/dracula-tufte-thanksgiving-light.theme.json" />
    <themeProvider id="com.e128.dracula-tufte-chartreuse-light" path="/dracula-tufte-chartreuse-light.theme.json" />
    <themeProvider id="com.e128.dracula-tufte-st-patrick-light" path="/dracula-tufte-st-patrick-light.theme.json" />
    <themeProvider id="com.e128.dracula-tufte-independence-day-light" path="/dracula-tufte-independence-day-light.theme.json" />
    <themeProvider id="com.e128.dracula-tufte-poland-light" path="/dracula-tufte-poland-light.theme.json" />
  </extensions>
</idea-plugin>
