{
  "name": "Dracula-Tufte (muted) Light",
  "dark": false,
  "author": "the maintainer",
  "editorScheme": "/dracula-tufte-light.xml",

  "colors": {
    "surface": "#fcfcf8",
    "surfaceAlt": "#efefea",
    "codeBg": "#f0f1f9",
    "onSurface": "#161616",
    "label": "#525879",
    "muted": "#626a8c",
    "ruleLight": "#7b7f94",
    "rule": "#d5d7da",
    "hover": "#e2e3e4",
    "pressed": "#c8cad0",
    "selection": "#fbfbff",
    "selectionSoft": "#d1dede",
    "link": "#397281",
    "orange": "#9c5b15",
    "red": "#d00932",
    "purple": "#7b58ae",
    "pink": "#ad447d",
    "green": "#057c47",
    "data1": "#3c88e4",
    "data2": "#cf5cae",
    "data3": "#349874",
    "data4": "#878c48"
