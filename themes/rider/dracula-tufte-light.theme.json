      "Objects.Pink": "#ad447d",
      "Objects.Yellow": "#878c48",
      "Objects.YellowDark": "#9c5b15",
      "Objects.Green": "#057c47",
      "Objects.GreenAndroid": "#349874",
      "Objects.Blue": "#3c88e4",
      "Objects.Purple": "#7b58ae",
      "Objects.BlackText": "#fcfcf8",
      "Checkbox.Background.Default": "#f0f1f9",
